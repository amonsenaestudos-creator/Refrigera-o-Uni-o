# Modo servidor (hospedagem Node + PostgreSQL)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
REPORT_TOKEN=troque-por-uma-senha-longa-e-aleatoria

# Endereço público do site, sem barra no final.
# No GitHub Pages, inclua a subpasta: https://usuario.github.io/repositorio
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Código de verificação do Google Search Console (opcional)
GOOGLE_SITE_VERIFICATION=

# --- Somente para a publicação estática no GitHub Pages ---
# Subpasta em que o site é servido. Normalmente deixe vazia: o fluxo do GitHub
# Actions já define este valor (veja .github/workflows/deploy-pages.yml).
# No modo servidor, o site fica na raiz e esta variável deve continuar vazia.
NEXT_PUBLIC_BASE_PATH=

# Ligada automaticamente por `npm run build:pages`; não é preciso definir à mão.
# NEXT_PUBLIC_STATIC_EXPORT=true
